<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Daily change log note at 00:40, after the nightly backup. Render this template before
  installation: replace every __PLACEHOLDER__, then copy it to ~/Library/LaunchAgents.
-->
<dict>
    <key>Label</key>
    <string>com.example.tandem.change-log</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/.venv/bin/python</string>
        <string>-m</string>
        <string>src.brain.connector.change_log</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TZ</key>
        <string>__TIMEZONE__</string>
        <key>TIMEZONE</key>
        <string>__TIMEZONE__</string>
        <key>BRAIN_DIR</key>
        <string>__REPO_ROOT__</string>
        <key>USER_DIR</key>
        <string>__REPO_ROOT__/user</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/change-log.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/change-log.log</string>
</dict>
</plist>

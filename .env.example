# Copy to .env, fill only the integrations you use, then chmod 600 .env.
# Paths must be absolute unless a comment explicitly says otherwise. A leading
# `~/` is expanded once at process startup before any component uses the path.

# --- Core -------------------------------------------------------------------

# Markdown vault or notes directory.
VAULT_PATH="/absolute/path/to/notes"

# IANA timezone used by schedules and dated records.
TIMEZONE="UTC"

# Optional overrides. Defaults are <repository>/search/data/vault.db and
# <repository>/user respectively.
# MEMORY_DB_PATH="/absolute/path/to/vault.db"
# USER_DIR="/absolute/path/to/private-user-overlay"


# --- Slack ------------------------------------------------------------------

# Create one app from config/slack_app_manifest.yaml. SLACK_BOT_TOKEN is the
# installed app's xoxb token. SLACK_APP_TOKEN is a separate xapp token with the
# connections:write scope.
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""

# Slack member ID (U...) for the deployment owner. Other authorized humans are
# scoped in the private integrations overlay.
OWNER_SLACK_USER_ID=""

# Optional fallback destination for system/doctor messages.
BRIEF_CHANNEL_ID=""


# --- Task manager -----------------------------------------------------------

# Required only when config/integrations.yaml selects the Todoist compatibility
# backend. Apple Reminders uses local EventKit instead.
TODOIST_API_TOKEN=""


# --- iCloud -----------------------------------------------------------------

# Apple-ID app-specific password used by CalDAV, CardDAV, and IMAP. Reminders
# uses local EventKit and requires a one-time macOS permission grant; see
# docs/INTEGRATIONS.md.
ICLOUD_APPLE_ID=""
ICLOUD_APP_PASSWORD=""

# Set only when the iCloud Mail mailbox name differs from the Apple ID.
ICLOUD_IMAP_USER=""

# Comma-separated aliases owned by this mailbox, used when constructing reply
# links. Do not list arbitrary Hide-My-Email relay addresses.
ICLOUD_FROM_ALIASES=""


# --- Gmail mail (optional) --------------------------------------------------

# Gmail IMAP address and app-specific password. Requires 2-Step Verification.
GMAIL_ADDRESS=""
GMAIL_APP_PASSWORD=""


# --- Backup monitoring (optional) ------------------------------------------

# The daemon backs up every night at 23:35 (src/orchestrator/local_backup.py):
# it commits the vault into a separate Git directory and keeps 7 dated copies
# of the database next to it, both on this Mac. Create the Git directory once
# with `git init --bare ~/brain-vault.git`, or point this at another one.
# BRAIN_VAULT_HISTORY="~/brain-vault.git"

# Set after installing the nightly backup job so brain doctor and the daemon's
# daily monitor alert when no successful backup has completed within 36 hours.
# BRAIN_BACKUP_EXPECTED="1"
# BRAIN_BACKUP_STAMP_PATH="/absolute/private/path/backup-success.stamp"

# Deliberate database-only deployments may opt out of otherwise-required roots.
# BRAIN_BACKUP_SKIP_VAULT="1"
# BRAIN_BACKUP_SKIP_USER="1"
# BRAIN_BACKUP_REQUIRE_HOUSING_DB="1"


# --- Scheduler/runtime overrides (optional) ---------------------------------

# Hard wall-clock timeout for reply-handling agents, in seconds.
# BRAIN_REPLY_TIMEOUT="180"

# Scheduler log path. Defaults to <USER_DIR>/logs/tandem.log.
# BRAIN_LOG_PATH="/absolute/path/to/tandem.log"

# --- Claude sign-in ---------------------------------------------------------
# Agents run on the Claude subscription that Claude Code is signed in with.
# Never set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN here: the runner and the
# doctor refuse to run with either, so usage is never billed to an API account.
# Only if the launchd job cannot read Claude Code's keychain login, run
# `claude setup-token` and put the token here (keep this file mode 600).
# CLAUDE_CODE_OAUTH_TOKEN=""

# Verification run: a real agent run against copies of the database, the
# vault and the private overlay, with every direct-effect tool blocked and every
# proposed action left waiting in the copied queue, never run. Needs
# BRAIN_SLACK_OFF=1 and MEMORY_DB_PATH, VAULT_PATH and USER_DIR pointing at
# folders that hold a .brain-verify-copy marker file (for MEMORY_DB_PATH, the
# database's folder). USER_DIR must be a copy of the
# overlay because the run's pictures are saved in its media folder and
# housekeeping's before step deletes old ones there; the checks run before any
# before step, and a failed one stops the agent. Never set it in the live .env.
# The closing run writes each place's morning message to morning-<place>.md
# next to the copied database instead of sending it.
# BRAIN_VERIFY_RUN="1"

# Tavily API key used only by the bounded web-search paths.
# Queries come from the vault-blind catalog or reply-time scope controls.
TAVILY_API_KEY=""


# --- Garmin watch sync (optional) ------------------------------------------

# Install the garmin extra and create the token store through an operator-run
# interactive login before enabling the scheduler job.
# GARMIN_ENABLED="false"
# GARMIN_TOKENSTORE="/absolute/path/to/.garminconnect"


# --- Feature switches (optional) --------------------------------------------

# Each is on when unset. Set one to 0, false, no or off and restart the daemon
# to turn that feature off, with no code change.

# Edit and Write for agents granted them, inside their own vault_paths.
# BRAIN_DIRECT_EDITS="1"

# The Agent tool: read-only helpers, up to each agent's max_helpers.
# BRAIN_HELPERS="1"

# The draw_chart and draw_image tools, and voice notes in Slack.
# BRAIN_MEDIA="1"

# The Whisper model file (ggml-small.bin) that transcribes voice notes; without it a voice note gets the "please type it" reply.
# BRAIN_WHISPER_MODEL="/absolute/path/to/ggml-small.bin"

# The follow_up run with its collector, and the follow_ups_digest, follow_ups_list,
# follow_ups_add and follow_ups_update tools.
# BRAIN_FOLLOWUPS="1"


# --- Pausing the agents (optional) ----------------------------------------

# When on, the daemon schedules no agent mode, skips the morning catch-up and
# answers conversational Slack replies with one fixed line. The action
# executor, approval buttons and code jobs (Garmin, public discovery) keep running.
# BRAIN_AGENTS_PAUSED="1"


# When on, a configured Slack notifier resolves to noop and no Slack listener
# is started. Remove it to bring Slack back.
# BRAIN_SLACK_OFF="1"


